{
  "name": "agent-knowledge-base",
  "version": "0.0.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "knowledge-base": "dist/cli/main.js"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:core && npm run build:web",
    "dev": "vite --config web/vite.config.ts",
    "test": "npm run build && node --test dist/**/*.test.js",
    "test:web": "node web/tests/browser.mjs",
    "cli": "node dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:recall": "npm run build:core && node --test dist/recall/recall.test.js && node tests/recall/cli.mjs",
    "test:chains": "npm run build:core && node --test tests/chains/chain.test.mjs",
    "demo:agent": "npm run build:core && node examples/agent/project-integration.mjs",
    "demo:recall": "npm run build:core && node tests/recall/demo.mjs",
    "test:semantic": "npm run build:core && node --test dist/semantic/*.test.js"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "cron-parser": "5.10.4",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
