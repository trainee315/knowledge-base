* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
# Unified diff context and verbatim command output retain their whitespace.
*.patch text eol=lf whitespace=-blank-at-eol
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.log text eol=lf whitespace=-blank-at-eof
*.txt text eol=lf
*.bat text eol=crlf
*.png binary
*.kbdemo binary
